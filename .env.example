# Copy to .env; never commit secrets. Enable only after credentials and fork are verified.
AUTOMATION_ENABLED=false
GITHUB_REPOSITORY=Nasdin/superset
TARGET_BRANCH=cognition-release-6.1
GITHUB_ALLOWED_ACTOR=Nasdin
TRIGGER_LABEL=cognition:repair
DEVIN_ORG_ID=org-f456da0f2e0940808b5c8b3a20312d8c
DEVIN_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
OPERATOR_TOKEN=
DEVIN_MAX_ACU=10
DEVIN_MAX_SESSIONS=6
SESSION_TIMEOUT_SECONDS=7200
SCAN_INTERVAL_SECONDS=86400
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
BATCH_WINDOW_SECONDS=60

# Dependabot PRs in the configured fork/release branch enter the same bounded queue.
DEPENDABOT_ENABLED=true

# Publish scoped evidence observations to Devin Knowledge; false retires app-owned notes.
LEARNING_ENABLED=true

# Generate Postgres and Superset secrets with: python3 scripts/configure_local_postgres.py
# That script writes only missing settings into ignored .env. Do not commit generated secrets.
# Optional public deployment settings are documented in docs/AWS_DEPLOYMENT.md.
