# Copy to .env, then run python3 scripts/configure_local_postgres.py.
# Set fork, branch and Devin organization BEFORE first startup: each ledger binds this scope.
# Postgres + Superset is the default Compose stack; compose.sqlite.yaml is the lightweight option.
# Never commit secrets. Enable paid automation only after credentials and scope are verified.
AUTOMATION_ENABLED=false
GITHUB_REPOSITORY=Nasdin/superset
TARGET_BRANCH=cognition-release-6.1
GITHUB_ALLOWED_ACTOR=Nasdin
TRIGGER_LABEL=cognition:repair
DEVIN_ORG_ID=org-f456da0f2e0940808b5c8b3a20312d8c
# Devin v3 service-user key or authorized PAT; legacy v1 keys/CLI login are not sufficient.
DEVIN_API_KEY=
# App GitHub access is separate from Devin's own GitHub integration.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
OPERATOR_TOKEN=
DEVIN_MAX_ACU=10
DEVIN_MAX_SESSIONS=6
SESSION_TIMEOUT_SECONDS=7200
SCAN_INTERVAL_SECONDS=86400
POLL_SECONDS=30
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
BATCH_WINDOW_SECONDS=60

# Dependabot PRs in the configured fork/release branch enter the same bounded queue.
DEPENDABOT_ENABLED=true

# Publish scoped evidence observations to Devin Knowledge; false retires app-owned notes.
LEARNING_ENABLED=true

# Generate Postgres and Superset secrets with: python3 scripts/configure_local_postgres.py
# That script creates missing/empty secrets and preserves nonempty values in ignored .env. Do not commit generated secrets.
# Optional public deployment settings are documented in docs/AWS_DEPLOYMENT.md.

# The helper generates POSTGRES_* passwords, ANALYTICS_SUPERSET_* secrets,
# OPERATOR_TOKEN and GITHUB_WEBHOOK_SECRET. It also writes these local defaults:
# SUPERSET_INTERNAL_URL=http://analytics-superset:8088/bi
# SUPERSET_PUBLIC_URL=http://127.0.0.1:8189/bi
# SUPERSET_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Default Compose constructs DATABASE_URL from POSTGRES_APP_PASSWORD.
# Direct Python processes may set DATABASE_URL for Postgres or a bare
# AUTOMATION_DATABASE path for SQLite; do not use sqlite:// URLs.
# Optional SQLite port: COGNITION_PORT=8002 (defaults to 8000).
# Configure an interactive login with python3 scripts/configure_login.py --local-http.
# The public overlay forces login on and Secure cookies; no password is built into source.
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
REVIEWER_PASSWORD_HASH=
# Public ingress also requires PUBLIC_HOST and HTTPS Superset URLs/origins.

# Optional: publish sanitized validation evidence for anonymous PR reviewers.
# Set to your app's HTTPS origin (no trailing path); blank retains Devin-only links.
# Only provider-confirmed PNG, MP4 and text/JSON are archived under /public-evidence/.
EVIDENCE_PUBLIC_URL=
